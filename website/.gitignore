# Un-ignore website sources caught by the root .gitignore's global rules
# (*.md, *.png, *.svg, *.txt, dot-files).
!*.md
!**/*.md
!**/*.png
!**/*.svg
!**/*.txt
!.nojekyll

# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
